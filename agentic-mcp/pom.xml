<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.huawei.smartom.agentic</groupId>
        <artifactId>DPOMBaseMCPServer</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>agentic-mcp</artifactId>
    <name>agentic-mcp</name>
    <description>Spring Boot entry point with MCP server (SSE) and tool registry.</description>

    <dependencies>
        <!-- Internal modules -->
        <dependency>
            <groupId>com.huawei.smartom.agentic</groupId>
            <artifactId>agentic-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.huawei.smartom.agentic</groupId>
            <artifactId>agentic-monitoring</artifactId>
        </dependency>
        <dependency>
            <groupId>com.huawei.smartom.agentic</groupId>
            <artifactId>agentic-diagnosis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.huawei.smartom.agentic</groupId>
            <artifactId>agentic-persistence</artifactId>
        </dependency>
        <dependency>
            <groupId>com.huawei.smartom.agentic</groupId>
            <artifactId>agentic-messaging</artifactId>
        </dependency>

        <!-- Spring Boot web + actuator -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.erdtman</groupId>
            <artifactId>java-json-canonicalization</artifactId>
        </dependency>

        <!-- Spring AI MCP Server (WebMvc + SSE) -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
        </dependency>

        <!-- Micrometer Prometheus endpoint -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- Logback JSON encoder -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.huawei.smartom.agentic.mcp.DpomBaseMcpServerApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
