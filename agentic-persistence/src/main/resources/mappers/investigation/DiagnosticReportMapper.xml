<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.huawei.smartom.agentic.persistence.DiagnosticReportMapper">
  <resultMap id="report" type="com.huawei.smartom.agentic.persistence.DiagnosticReportRow">
    <constructor><idArg column="id" javaType="java.lang.Long"/><arg column="report_id" javaType="java.lang.String"/>
      <arg column="request_id" javaType="java.lang.String"/><arg column="request_digest" javaType="java.lang.String"/>
      <arg column="incident_id" javaType="java.lang.String"/><arg column="investigation_id" javaType="java.lang.String"/>
      <arg column="run_id" javaType="java.lang.String"/><arg column="revision_number" javaType="_long"/>
      <arg column="supersedes_report_id" javaType="java.lang.String"/><arg column="change_reason" javaType="java.lang.String"/>
      <arg column="source_digest" javaType="java.lang.String"/><arg column="canonical_json" javaType="java.lang.String"/>
      <arg column="report_digest" javaType="java.lang.String"/><arg column="completeness" javaType="java.lang.String"/>
      <arg column="created_by" javaType="java.lang.String"/><arg column="created_at" javaType="java.time.Instant"/>
    </constructor>
  </resultMap>
  <insert id="insertReport">INSERT INTO diagnostic_report(report_id,request_id,request_digest,incident_id,
    investigation_id,run_id,revision_number,supersedes_report_id,change_reason,source_digest,canonical_json,
    report_digest,completeness,created_by,created_at) VALUES(#{reportId},#{requestId},#{requestDigest},#{incidentId},
    #{investigationId},#{runId},#{revisionNumber},#{supersedesReportId},#{changeReason},#{sourceDigest},#{canonicalJson},
    #{reportDigest},#{completeness},#{createdBy},#{createdAt})</insert>
  <insert id="insertAudit">INSERT INTO diagnostic_report_audit(audit_id,report_id,action,actor_id,reason_code,recorded_at)
    VALUES(#{auditId},#{reportId},#{action},#{actorId},#{reasonCode},#{recordedAt})</insert>
  <select id="find" resultMap="report">SELECT * FROM diagnostic_report WHERE report_id=#{reportId}</select>
  <select id="findByRequest" resultMap="report">SELECT * FROM diagnostic_report WHERE request_id=#{requestId}</select>
  <select id="latest" resultMap="report">SELECT * FROM diagnostic_report WHERE investigation_id=#{investigationId} ORDER BY revision_number DESC LIMIT 1</select>
  <select id="page" resultMap="report">SELECT * FROM diagnostic_report WHERE investigation_id=#{investigationId}
    <if test="beforeRevision != null">AND revision_number &lt; #{beforeRevision}</if>
    ORDER BY revision_number DESC LIMIT #{limit}</select>
</mapper>
