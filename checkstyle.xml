<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  DPOMBaseMCPServer Checkstyle configuration.
  Derived from team's IntelliJ HWCodeFormatter spec.
  See CLAUDE.md §3 for the full convention rationale.
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <!-- Line length -->
    <module name="LineLength">
        <property name="max" value="120"/>
        <property name="ignorePattern" value="^package.*|^import.*|^ *\* .*|@see .*|@link .*"/>
    </module>

    <!-- No trailing whitespace -->
    <module name="RegexpSingleline">
        <property name="format" value="\s+$"/>
        <property name="message" value="Line has trailing whitespace."/>
    </module>

    <!-- No tabs (file-level check, must be a direct child of Checker) -->
    <module name="FileTabCharacter">
        <property name="eachLine" value="true"/>
    </module>

    <!--
      File header must carry the Huawei copyright notice.
      Required format (first three lines of every .java file):
          /*
           * Copyright (c) Huawei Technologies Co., Ltd 2026-2026, All rights reserved.
           */
    -->
    <module name="RegexpHeader">
        <property name="fileExtensions" value="java"/>
        <property name="header"
                  value="^/\*$\n^ \* Copyright \(c\) Huawei Technologies Co\., Ltd\. 2026-2026, All rights reserved\.$\n^ \*/$"/>
    </module>

    <module name="TreeWalker">
        <!-- Imports -->
        <module name="AvoidStarImport"/>
        <module name="UnusedImports"/>
        <module name="RedundantImport"/>

        <!-- Indentation: 4 spaces, continuation 4 spaces -->
        <module name="Indentation">
            <property name="basicOffset" value="4"/>
            <property name="braceAdjustment" value="0"/>
            <property name="caseIndent" value="4"/>
            <property name="throwsIndent" value="4"/>
            <property name="lineWrappingIndentation" value="4"/>
            <property name="arrayInitIndent" value="4"/>
        </module>

        <!-- Braces always required -->
        <module name="NeedBraces">
            <property name="tokens"
                      value="LITERAL_DO, LITERAL_ELSE, LITERAL_FOR, LITERAL_IF, LITERAL_WHILE"/>
            <property name="allowSingleLineStatement" value="false"/>
        </module>
        <module name="LeftCurly">
            <property name="option" value="eol"/>
        </module>
        <module name="RightCurly">
            <property name="option" value="same"/>
        </module>

        <!-- Spaces -->
        <module name="WhitespaceAround">
            <property name="allowEmptyConstructors" value="true"/>
            <property name="allowEmptyMethods" value="true"/>
            <property name="allowEmptyTypes" value="true"/>
            <property name="allowEmptyLoops" value="true"/>
        </module>
        <module name="WhitespaceAfter">
            <property name="tokens" value="COMMA, SEMI, TYPECAST"/>
        </module>
        <module name="NoWhitespaceBefore">
            <property name="tokens" value="COMMA, SEMI, POST_DEC, POST_INC"/>
        </module>

        <!-- Modifier order -->
        <module name="ModifierOrder"/>
        <module name="RedundantModifier"/>

        <!--
          Naming.
          PackageName keeps its dotted-segment regex.
          All other identifiers must match \w{2,64} — 2 to 64 word
          characters. This rules out single-letter names (loop vars,
          lambda/catch params, etc.). Generic type parameters live under
          a different token type and are not affected by these modules.
        -->
        <module name="PackageName">
            <property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
        </module>
        <module name="TypeName">
            <property name="format" value="^\w{2,64}$"/>
        </module>
        <module name="MethodName">
            <property name="format" value="^\w{2,64}$"/>
        </module>
        <module name="LocalVariableName">
            <property name="format" value="^\w{2,64}$"/>
        </module>
        <module name="ParameterName">
            <property name="format" value="^\w{2,64}$"/>
        </module>
        <module name="ConstantName">
            <property name="format" value="^\w{2,64}$"/>
        </module>
        <module name="MemberName">
            <property name="format" value="^\w{2,64}$"/>
        </module>
        <!--
          Lambda parameters are a separate token in Checkstyle and are
          not covered by ParameterName, so they need their own module.
          Same \w{2,64} length requirement applies.
        -->
        <module name="LambdaParameterName">
            <property name="format" value="^\w{2,64}$"/>
        </module>

        <!-- General -->
        <module name="EmptyBlock">
            <property name="option" value="text"/>
        </module>
        <module name="EmptyStatement"/>
        <module name="EqualsHashCode"/>
        <module name="MissingSwitchDefault"/>
        <module name="SimplifyBooleanExpression"/>
        <module name="SimplifyBooleanReturn"/>
        <module name="DefaultComesLast"/>
        <module name="FallThrough"/>

        <!--
          Source file structure: copyright header, package, imports,
          top-level type, each separated by a blank line. RegexpHeader
          (Checker level) covers the copyright; EmptyLineSeparator enforces
          the rest.
        -->
        <module name="EmptyLineSeparator">
            <property name="tokens"
                      value="PACKAGE_DEF, IMPORT, CLASS_DEF, INTERFACE_DEF, ENUM_DEF, RECORD_DEF,
                             STATIC_INIT, INSTANCE_INIT, METHOD_DEF, CTOR_DEF"/>
            <property name="allowNoEmptyLineBetweenFields" value="true"/>
            <property name="allowMultipleEmptyLines" value="false"/>
            <property name="allowMultipleEmptyLinesInsideClassMembers" value="false"/>
        </module>

        <!--
          Top-level public class/interface/enum/record must have Javadoc
          containing a description and a creation date (the @since tag).
        -->
        <module name="MissingJavadocType">
            <property name="scope" value="public"/>
            <property name="tokens" value="CLASS_DEF, INTERFACE_DEF, ENUM_DEF, RECORD_DEF"/>
        </module>
        <module name="JavadocType">
            <property name="scope" value="public"/>
            <property name="tokens" value="CLASS_DEF, INTERFACE_DEF, ENUM_DEF, RECORD_DEF"/>
        </module>
        <!--
          WriteTag requires an @since YYYY-MM-DD tag on every type
          definition. Severity=error fires when the tag is missing or has
          the wrong format; tagSeverity=ignore keeps successful matches
          silent. WriteTag has no scope property, so it applies to package-
          private types as well — acceptable trade-off for a uniform rule.
        -->
        <module name="WriteTag">
            <property name="tag" value="@since"/>
            <property name="tagFormat" value="\d{4}-\d{2}-\d{2}"/>
            <property name="tagSeverity" value="ignore"/>
            <property name="severity" value="error"/>
            <property name="tokens" value="CLASS_DEF, INTERFACE_DEF, ENUM_DEF, RECORD_DEF"/>
        </module>
        <!--
          @author tag is required on every type definition. Any non-empty
          value is accepted (no format constraint). Lives on the line
          immediately above @since, enforced by AtclauseOrder below.
        -->
        <module name="WriteTag">
            <property name="tag" value="@author"/>
            <property name="tagSeverity" value="ignore"/>
            <property name="severity" value="error"/>
            <property name="tokens" value="CLASS_DEF, INTERFACE_DEF, ENUM_DEF, RECORD_DEF"/>
        </module>

        <!--
          Public methods (and constructors) require Javadoc with a
          description. @param / @return / @throws must be present wherever
          they apply, and AtclauseOrder enforces the ordering
          @param -> @return -> @throws.
        -->
        <module name="MissingJavadocMethod">
            <property name="scope" value="public"/>
            <property name="allowMissingPropertyJavadoc" value="false"/>
            <property name="tokens" value="METHOD_DEF, CTOR_DEF"/>
        </module>
        <!--
          JavadocMethod validates every method that has a Javadoc block,
          regardless of access modifier. MissingJavadocMethod (above)
          still only forces Javadoc presence on public methods, so private
          helpers are not required to carry one — but if they do, the
          tags must be complete (e.g. @return on a non-void method).
        -->
        <module name="JavadocMethod">
            <property name="accessModifiers" value="public, protected, package, private"/>
            <property name="validateThrows" value="true"/>
            <property name="allowMissingParamTags" value="false"/>
            <property name="allowMissingReturnTag" value="false"/>
        </module>
        <module name="AtclauseOrder">
            <property name="tagOrder" value="@param, @return, @throws, @exception, @author, @since"/>
            <property name="target"
                      value="CLASS_DEF, INTERFACE_DEF, ENUM_DEF, RECORD_DEF,
                             METHOD_DEF, CTOR_DEF, VARIABLE_DEF"/>
        </module>
        <module name="NonEmptyAtclauseDescription"/>

        <!-- No System.out / printStackTrace -->
        <module name="Regexp">
            <property name="format" value="System\.out\."/>
            <property name="message" value="Use SLF4J logger instead of System.out"/>
            <property name="illegalPattern" value="true"/>
        </module>
        <module name="Regexp">
            <property name="format" value="printStackTrace"/>
            <property name="message" value="Use SLF4J logger instead of printStackTrace"/>
            <property name="illegalPattern" value="true"/>
        </module>
    </module>
</module>
